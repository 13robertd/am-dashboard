# Copy to .env.local and fill in. Never commit .env.local.
# All three values come from Supabase Dashboard → Settings → API.
#
# NEXT_PUBLIC_* are bundled into the client. The service role key is
# server-side only (used for local migrations / supabase CLI) and must
# never reach Vercel or the browser.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local-only — never set this in Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Local-only — for `supabase db push` against the linked project.
SUPABASE_DB_PASSWORD=
